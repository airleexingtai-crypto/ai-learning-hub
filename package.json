{
  "name": "ai-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-rss.cjs",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && npx wrangler pages deploy out/ --project-name=ai-learning-hub --commit-dirty=true",
    "ship": "git add src/content/articles/ && git diff --cached --quiet || git commit -m \"content: article update $(date +%Y-%m-%d)\" && npm run deploy"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
